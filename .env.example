# Copy to .env.local and fill in.

# Gemini, through its OpenAI-compatible endpoint.
# Swap these three to change to any other OpenAI-compatible provider.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Interviewer voice: elevenlabs | browser
# "browser" uses Chrome's built-in voice and needs no key.
# Any ElevenLabs failure falls back to the browser voice automatically.
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
# Optional overrides: an ElevenLabs voice id and model id.
TTS_VOICE=
TTS_MODEL=
